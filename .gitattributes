# Deployment artifacts are checked out on Linux from a Windows working copy, so
# pin the line endings explicitly instead of trusting core.autocrlf: a shell
# script with CRLF fails with "bad interpreter", and a .cmd with LF misbehaves.
*.sh      text eol=lf
*.service text eol=lf
*.pem     text eol=lf
*.cmd     text eol=crlf

# Markdown and workflow files are asserted byte-for-byte by the suite (the skill
# frontmatter must start with "---\n") and are diffed in review. A Windows
# checkout with core.autocrlf=true would otherwise turn them into CRLF and fail
# tests that pass on the machine that wrote the files.
*.md      text eol=lf
*.yml     text eol=lf
