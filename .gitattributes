# Deployment artifacts are checked out on Linux from a Windows working copy, so
# pin the line endings explicitly instead of trusting core.autocrlf: a shell
# script with CRLF fails with "bad interpreter", and a .cmd with LF misbehaves.
*.sh      text eol=lf
*.service text eol=lf
*.pem     text eol=lf
*.cmd     text eol=crlf
